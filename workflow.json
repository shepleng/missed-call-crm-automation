        "message": "=A GoHighLevel request failed in the Missed Call to CRM workflow.\n\nError: {{ (() => { const e = $input.item.json['error']; return (e && (e.message || e.description)) || (typeof e === 'string' ? e : JSON.stringify($input.item.json)); })() }}\n\nCaller: {{ $('Clean Caller Fields').item.json.name }} ({{ $('Clean Caller Fields').item.json.phone }})\nCall time: {{ $('Clean Caller Fields').item.json.call_time }}\nExecution: {{ $execution.id }}",
        "options": {
          "appendAttribution": false
        }
