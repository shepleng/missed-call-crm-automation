{
  "name": "Synclo – Missed Call to CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "synclo-missed-call",
        "options": {}
      },
      "id": "c5779fe8-84c1-4d54-828b-b97b22b094ad",
      "name": "Missed Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        128
      ],
      "webhookId": "61b44e02-d208-4982-ad57-e483393e583a"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f-name",
              "name": "name",
              "type": "string",
              "value": "={{ String($json.body.name ?? '').trim() || 'New Caller' }}"
            },
            {
              "id": "f-phone",
              "name": "phone",
              "type": "string",
              "value": "={{ (() => { const raw = String($json.body.phone ?? '').trim(); const d = raw.replace(/\\D/g, ''); if (!d) return ''; if (raw.startsWith('+')) return '+' + d; if (d.startsWith('0061')) return '+' + d.slice(2); if (d.startsWith('61')) return '+' + d; if (d.startsWith('0')) return '+61' + d.slice(1); return '+61' + d; })() }}"
            },
            {
              "id": "f-email",
              "name": "email",
              "type": "string",
              "value": "={{ String($json.body.email ?? '').trim() }}"
            },
            {
              "id": "f-time",
              "name": "call_time",
              "type": "string",
              "value": "={{ $json.body.call_time || $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "01e0249a-6eda-4b91-9b9f-0e73eff1fbd2",
      "name": "Clean Caller Fields",
